# =============================================================================
# Plasma Store — variables de entorno (ejemplo)
# =============================================================================
# Paso 1: copy .env.example .env.local
# Paso 2: Local rápido → deja DB_DRIVER=sqlite (no necesita Mongo/Atlas)
# Paso 3: npm run check-env && npm run create-admin && npm run dev
# =============================================================================

# --- Base de datos ---
# sqlite = archivo local (rápido, recomendado en desarrollo)
# mongo  = MongoDB Atlas / servidor Mongo
DB_DRIVER=sqlite
# SQLITE_PATH=server/data/local.sqlite
# Ruta al SQLite del POS (import: npm run import-pos-products)
# POS_SQLITE_PATH=C:\Users\bater\Desktop\plasma store\data\pos.sqlite3

# Solo si DB_DRIVER=mongo:
# MONGODB_URI=mongodb+srv://USUARIO:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=plasmastore

APP_SESSION_SECRET=cambia-por-un-secreto-largo-aleatorio-minimo-32-caracteres

# Solo si ejecutas Express solo: node server/src/index.mjs
PORT=3847

# --- npm run create-admin / set-admin-password ---
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=admin123

# --- POST /api/store/bootstrap-admin (opcional) ---
# BOOTSTRAP_TOKEN=token-secreto

# Webpay (opcional)
# WEBPAY_ENV=integration
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# PUBLIC_BASE_URL=http://localhost:3000
# En local, para probar checkout sin Transbank:
WEBPAY_MOCK=1

# TUU Pago Online (opcional; también en Admin → Sistema de pago)
# TUU_ENABLED=1
# TUU_ENV=integration
# TUU_ACCOUNT_ID=
# TUU_SECRET=

# Correo SMTP (también configurable en Admin → Correo)
# Gmail: smtp.gmail.com:587 + contraseña de aplicación
# SMTP_ENABLED=1
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tutienda@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=tutienda@gmail.com
# SMTP_FROM_NAME=Plasma Store
# SMTP_NOTIFY_ORDERS=tutienda@gmail.com

# Entrega (carrito)
# Envío: solo aviso (Starken / por pagar). No se suma al total de Webpay.
STORE_SHIPPING_NOTE=Los envíos se realizan por Starken los días jueves, por pagar (pago contra entrega).
STORE_PICKUP_ADDRESS=Plasma Store — Av. Ejemplo 123, Santiago. Horario Lun–Sáb 11:00–19:00.